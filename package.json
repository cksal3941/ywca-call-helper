{
  "name": "ywca-call-helper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "sync": "node scripts/sync-courses.mjs",
    "server": "node server/index.mjs",
    "start": "npm run build && npm run server",
    "pm2:setup": "powershell -ExecutionPolicy Bypass -File scripts/pm2-setup.ps1",
    "pm2:deploy": "powershell -ExecutionPolicy Bypass -File scripts/pm2-deploy.ps1",
    "pm2:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/pm2-uninstall.ps1"
  },
  "dependencies": {
    "express": "^4.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
